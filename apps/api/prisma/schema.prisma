generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  IMAGE
  VIDEO
  AUDIO
  CODE
  MODEL_3D
}

enum PostVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PostStatus {
  PROCESSING
  PUBLISHED
  FAILED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  status       UserStatus @default(PENDING_VERIFICATION)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  posts    Post[]
  sessions Session[]
  likes    Like[]

  @@map("users")
}

model Post {
  id String @id @default(uuid())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  description String?

  contentType ContentType
  visibility  PostVisibility @default(PUBLIC)
  status      PostStatus     @default(PUBLISHED)

  // IMAGE / VIDEO / AUDIO / MODEL_3D uchun (diskdagi nisbiy fayl yo'li, masalan storage/uploads/... ostida)
  mediaPath     String?
  thumbnailPath String?
  width         Int?
  height        Int?

  // CODE uchun
  codeContent       String? @db.Text
  codeLanguage      String?
  codeHighlightHtml String? @db.Text // tayyor syntax-highlight HTML keshi

  viewCount  Int @default(0)
  likeCount  Int @default(0)
  remixCount Int @default(0)

  isNsfw Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags PostTag[]
  likes Like[]

  @@index([authorId])
  @@index([contentType, visibility, status, createdAt])
  @@map("posts")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// GET /posts/:id'da `viewerHasLiked`ni aniqlash uchun kerakli minimal
/// jadval. Like/unlike endpointlari (POST/DELETE) V1'ning shu bosqichida
/// hali yozilmagan — bu model faqat "foydalanuvchi bu postni like
/// bosganmi?" degan savolga javob berish uchun zarur bo'lgani sababli
/// qo'shildi.
model Like {
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
  @@map("likes")
}